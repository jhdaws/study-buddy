# Copy to .env (for `docker compose up`) or .env.local (for `npm run dev`)
# and fill in. The Supabase values are required: every page returns an error
# without them. Without the Google browser key, the /sessions map says
# "Map unavailable" and the list works as before.
#
# Docker Compose local defaults (public demo JWTs from `supabase start` —
# not secrets; safe in .env.example):
#   NEXT_PUBLIC_SUPABASE_URL=http://host.docker.internal:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
#   SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
#
# One-command local stack (ADR 0012 / Sprint 5 V2):
#   cp .env.example .env   # then set the three values above for Compose
#   docker compose up --build
# App: http://localhost:3000  ·  Mailpit: http://localhost:54324

# --- Supabase ----------------------------------------------------------
#
# Hosted project: URL from Project Settings -> Data API, key from Project
# Settings -> API Keys ("publishable" key, or the legacy "anon" key).
# Local database: run `npm run db:status` and use API_URL and the publishable
# (or anon) key it prints.
#
# Both values are safe to expose to the browser. The key grants no access on
# its own -- access is governed by the database's own policies.

# Local Compose defaults (public demo JWTs). For `npm run dev` against a
# hosted project, replace with Project Settings → Data API / API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://host.docker.internal:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Secret key (ADR 0008). SERVER ONLY. Never prefix it NEXT_PUBLIC_, never
# commit a real value, never read it from client code. It bypasses Row Level
# Security entirely: it is used only to write location rows after the server
# has validated a place (M3, src/lib/supabase/admin.ts). Needed once the
# picker offers real Google places (M2); the stub picker's fixture places
# resolve without it. Hosted: Project Settings -> API Keys, "secret" key.
# Local: the secret key `npm run db:status` prints (Compose default below).

SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU


# --- Google Maps (ADR 0007, ADR 0008) ----------------------------------
#
# This key ships in client-side JavaScript. It is NOT a secret and cannot be
# made one -- anyone can read it from the page source.
#
# Restrict it in the Google Cloud console before using it anywhere real:
#   - Application restriction: HTTP referrers (your Vercel domain + localhost)
#   - API restriction: only the Maps/Places APIs you actually call
#
# An unrestricted key in a public repository is the standard way a student
# project acquires a bill.

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Map ID for the /sessions map (M4): Google Cloud console -> Map Management.
# Advanced Markers need one. Not a secret. Leave it empty to use Google's
# DEMO_MAP_ID, which works with any key.

NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Separate key for server-side Places calls (validating a submitted location).
# Never prefix it NEXT_PUBLIC_ -- that prefix is what exposes a variable to
# the browser. Restrict it in the Google Cloud console:
#   - API restriction: the Places API only
#   - A daily quota cap on that API, so a leaked key costs a bounded amount
# NOT by IP: Vercel functions have no fixed outbound IP (ADR 0008 supersedes
# ADR 0007 here). Unverified against current Google and Vercel docs -- M1.
#
# Set BOTH Google keys, or NEITHER, in each environment (M2). With the browser
# key the picker offers real places, which the server can only look up with
# this key (plus SUPABASE_SECRET_KEY, to store them). With this key in a
# production build, the fake test places are refused (src/lib/places.ts).
# Without either, the picker offers three fake test places. The browser key is
# inlined at build time: redeploy after changing it. A Vercel production build
# with only one of the two fails on purpose (next.config.ts, BUG-19).

GOOGLE_MAPS_SERVER_API_KEY=
