# Copy to .env.local and fill in. The Supabase values are required: every page
# returns an error without them. The Google values are not needed until the map
# work lands.

# --- Supabase ----------------------------------------------------------
#
# Hosted project: URL from Project Settings -> Data API, key from Project
# Settings -> API Keys ("publishable" key, or the legacy "anon" key).
# Local database: run `npm run db:status` and use API_URL and the publishable
# (or anon) key it prints.
#
# Both values are safe to expose to the browser. The key grants no access on
# its own -- access is governed by the database's own policies.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key (ADR 0008). SERVER ONLY. Never prefix it NEXT_PUBLIC_, never
# commit a real value, never read it from client code. It bypasses Row Level
# Security entirely: it is used only to write location rows after the server
# has validated a place (M3). Not needed until M3 lands -- leave it commented.
# Hosted: Project Settings -> API Keys, "secret" key. Local: the secret key
# `npm run db:status` prints.
#
# SUPABASE_SECRET_KEY=


# --- Google Maps (ADR 0007, ADR 0008) ----------------------------------
#
# This key ships in client-side JavaScript. It is NOT a secret and cannot be
# made one -- anyone can read it from the page source.
#
# Restrict it in the Google Cloud console before using it anywhere real:
#   - Application restriction: HTTP referrers (your Vercel domain + localhost)
#   - API restriction: only the Maps/Places APIs you actually call
#
# An unrestricted key in a public repository is the standard way a student
# project acquires a bill.

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Separate key for server-side Places calls (validating a submitted location).
# Never prefix it NEXT_PUBLIC_ -- that prefix is what exposes a variable to
# the browser. Restrict it in the Google Cloud console:
#   - API restriction: the Places API only
#   - A daily quota cap on that API, so a leaked key costs a bounded amount
# NOT by IP: Vercel functions have no fixed outbound IP (ADR 0008 supersedes
# ADR 0007 here). Unverified against current Google and Vercel docs -- M1.

GOOGLE_MAPS_SERVER_API_KEY=
